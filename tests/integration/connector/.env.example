# Connector Integration Test Environment Variables
# Copy this file to .env and fill in your credentials
# The .env file is git-ignored for security

# ========================================
# HYPERLIQUID CONNECTOR
# ========================================
# No 0x prefix
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_TESTNET=false
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz

# ========================================
# PARADEX CONNECTOR
# ========================================
PARADEX_ACCOUNT_ADDRESS=0x...
PARADEX_ETH_PRIVATE_KEY=0x...
PARADEX_NETWORK=testnet
PARADEX_BASE_URL=https://api.testnet.paradex.trade/consumer
PARADEX_WS_URL=wss://ws.testnet.paradex.trade/v1
PARADEX_STARKNET_RPC=https://starknet-sepolia.public.blastapi.io

# ========================================
# BYBIT CONNECTOR
# ========================================
BYBIT_API_KEY=your_api_key
BYBIT_API_SECRET=your_api_secret
BYBIT_TESTNET=true

# ========================================
# GATE.IO SPOT CONNECTOR
# ========================================
GATE_API_KEY=your_api_key
GATE_API_SECRET=your_api_secret
GATE_TESTNET=true

# ========================================
# POLYMARKET CONNECTOR
# ========================================
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
# Must be the address generated by Polymarket, not your EOA
POLYMARKET_ADDRESS=

# ========================================
# DERIBIT OPTIONS CONNECTOR
# ========================================
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_WS_URL=wss://www.deribit.com/ws/api/v2
DERIBIT_TESTNET=false

# ========================================
# UNISWAP V3 ONCHAIN CONNECTOR
# ========================================
# Required for onchain suite (skips if unset)
UNISWAP_V3_RPC_URL=
UNISWAP_V3_CHAIN_ID=
UNISWAP_V3_WETH=
UNISWAP_V3_SWAP_ROUTER=
UNISWAP_V3_QUOTER=
# Optional: live swap path (leave empty for dry_run)
UNISWAP_V3_PRIVATE_KEY=
UNISWAP_V3_ACCOUNT_ADDRESS=
UNISWAP_V3_DRY_RUN=true
UNISWAP_V3_NETWORK=robinhood
# Base token for buy e2e (pair = BASE/WETH)
UNISWAP_V3_BASE_TOKEN=
UNISWAP_V3_BASE_SYMBOL=TEST
